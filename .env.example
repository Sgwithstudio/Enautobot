PORT=3470
HOST=127.0.0.1
PUBLIC_URL=https://en.smarc-wms.cloud
# Dán token Cloudflare Tunnel vào đây (Zero Trust > Networks > Tunnels > token)
CF_TUNNEL_TOKEN=
# Mã PIN đăng nhập app (bắt buộc đặt khi mở ra internet, vì Codex dùng quota của bạn)
APP_PIN=
CODEX_MODEL=gpt-5.5
CODEX_EFFORT=low
CODEX_CONCURRENCY=2
# Giới hạn số lượt gọi Codex mỗi giờ
CODEX_MAX_PER_HOUR=60
